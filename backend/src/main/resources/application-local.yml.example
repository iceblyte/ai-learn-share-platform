# ============================================================
# 本地开发配置模板 —— 本文件只含占位符，可安全提交
#
# 用法：复制为同目录下的 application-local.yml 后填入自己的真实值
#   PowerShell:  Copy-Item application-local.yml.example application-local.yml
#   bash:        cp application-local.yml.example application-local.yml
#
# application-local.yml 已被 .gitignore 忽略，任何真实凭据都不应提交。
# 也可以不建这个文件，全部改用环境变量（见 README「后端启动」一节）。
# ============================================================

spring:
  # MySQL
  datasource:
    password: "<your-mysql-password>"

  # Redis
  data:
    redis:
      host: localhost
      password: "<your-redis-password>"   # 无密码就留空字符串
      database: 0

  # AI - DeepSeek（OpenAI 兼容模式）
  ai:
    openai:
      api-key: "<your-deepseek-api-key>"

# ============================================================
# 扩展五：AI 聊天工作流（可选，层级镜像 application.yml 的 ai.*）
#   以下 key 均可缺省：未配置的生图源在 imageCollect 节点自动跳过，
#   由其余源兜底；全部不配则只有 unDraw 本地插图映射生效。
#   对应环境变量：IMAGE_PEXELS_API_KEY / IMAGE_WANX_API_KEY
# ============================================================
ai:
  image:
    pexels:
      api-key: "<your-pexels-api-key>"       # https://www.pexels.com/api/ 免费申请
    wanx:
      api-key: "<your-dashscope-api-key>"    # 阿里云百炼 DashScope，通义万相文生图

# ============================================================
# 扩展六：Tavily 联网搜索（AI 问答「智能搜索」按钮，可选）
#   https://tavily.com 免费申请（免费档每月 1000 次）
#   留空时智能搜索自动降级为无来源回答；对应环境变量 TAVILY_API_KEY
# ============================================================
tavily:
  api-key: "<your-tavily-api-key>"

# File Storage
# type: local → 存到 ./uploads；type: oss → 需要下面的 access-key-*
storage:
  type: local
  oss:
    access-key-id: "<your-oss-access-key-id>"
    access-key-secret: "<your-oss-access-key-secret>"

# JWT 签名密钥：至少 32 字节，缺失 / 过短 / 使用示例值时应用拒绝启动
jwt:
  secret: "<your-jwt-secret-at-least-32-chars>"
